{
  "name": "tr3x",
  "version": "0.0.24",
  "private": true,
  "description": "Terminal-first T3 Code fork with an OpenTUI client",
  "homepage": "https://github.com/phillip-hirsch/tr3x#readme",
  "bugs": {
    "url": "https://github.com/phillip-hirsch/tr3x/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phillip-hirsch/tr3x.git",
    "directory": "apps/tui"
  },
  "bin": {
    "tr3x": "./bin/tr3x.js"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.tsx",
    "dev:headless": "TR3X_HEADLESS=1 bun run src/index.tsx",
    "build": "bun run scripts/build-runtime.mjs && node scripts/bundle-server-dist.mjs",
    "start": "bun dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "check:transcript": "bun scripts/check-transcript.tsx",
    "check:composer": "bun scripts/check-composer.tsx",
    "check:requests": "bun scripts/check-request-panel.tsx",
    "check:management": "bun scripts/check-management.tsx",
    "check:terminal": "bun scripts/check-terminal.tsx",
    "check:diff": "bun scripts/check-diff.tsx",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@opentui/core": "0.2.7",
    "@opentui/react": "0.2.7",
    "@t3tools/client-runtime": "workspace:*",
    "effect": "catalog:",
    "react": "^19.0.0",
    "react-devtools-core": "^7.0.1",
    "scheduler": "^0.27.0",
    "web-tree-sitter": "0.25.10",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@t3tools/client-core": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "catalog:"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "0.2.7",
    "@opentui/core-darwin-x64": "0.2.7",
    "@opentui/core-linux-arm64": "0.2.7",
    "@opentui/core-linux-x64": "0.2.7",
    "@opentui/core-win32-arm64": "0.2.7",
    "@opentui/core-win32-x64": "0.2.7"
  },
  "engines": {
    "bun": ">=1.3.9",
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
